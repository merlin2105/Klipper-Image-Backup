#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Verwendung: sudo kibm-admin {status|logs|usb|restart|update}" >&2
  exit 2
}

[[ $# -eq 1 ]] || usage

case "$1" in
  status)
    exec /usr/bin/systemctl status kibm.service kibm-media.service kibm-auth.service kibm-update.service --no-pager -l
    ;;
  logs)
    exec /usr/bin/journalctl -u kibm.service -u kibm-media.service -u kibm-auth.service -u kibm-update.service -n 100 --no-pager
    ;;
  usb)
    exec /usr/sbin/runuser -u kibm -- /opt/klipper-image-backup-manager/venv/bin/python -c '
import json
import socket

with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
    client.settimeout(10)
    client.connect("/run/kibm-media/worker.sock")
    client.sendall(json.dumps({"action": "devices"}).encode() + b"\n")
    print(client.makefile("rb").readline(1024 * 1024).decode(), end="")
'
    ;;
  restart)
    /usr/bin/systemctl restart kibm-media.service kibm.service
    exec /usr/bin/systemctl status kibm.service kibm-media.service --no-pager -l
    ;;
  update)
    # Manual SSH update: install the current GitHub main, not an older web confirmation.
    /usr/bin/rm -f -- /run/kibm-media/update-commit
    exec /usr/local/sbin/kibm-admin update-run
    ;;
  update-run)
    [[ $EUID -eq 0 ]] || { echo "Update-Dienst muss als root laufen." >&2; exit 1; }
    operator=$(/usr/bin/cat /etc/kibm/admin-user)
    [[ -n "$operator" && "$operator" != root ]] || { echo "Pi-Benutzer konnte nicht erkannt werden." >&2; exit 1; }
    workdir=$(/usr/bin/mktemp -d /tmp/kibm-admin-update.XXXXXX)
    trap '/usr/bin/rm -rf -- "$workdir"' EXIT
    confirmed=
    if [[ -f /run/kibm-media/update-commit ]]; then
      confirmed=$(/usr/bin/cat /run/kibm-media/update-commit)
      /usr/bin/rm -f -- /run/kibm-media/update-commit
      [[ $confirmed =~ ^[0-9a-f]{40}$ ]] || { echo "Die bestätigte Update-Version ist ungültig." >&2; exit 1; }
    fi
    # Only releases tagged and signed with a key from /etc/kibm/allowed_signers are installed.
    release=$(/usr/local/sbin/kibm-fetch-release https://github.com/merlin2105/Klipper-Image-Backup.git \
      /etc/kibm/allowed_signers "$workdir/source")
    read -r tag latest <<< "$release"
    [[ $latest =~ ^[0-9a-f]{40}$ ]] || { echo "Das signierte Release lieferte keine gültige Commit-ID." >&2; exit 1; }
    if [[ -n $confirmed && $confirmed != "$latest" ]]; then
      echo "Das neueste signierte Release hat sich seit der Bestätigung geändert (bestätigt $confirmed, aktuell $tag $latest). Bitte im Dashboard erneut auf Update prüfen." >&2
      exit 1
    fi
    current=$(/usr/bin/python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("commit", ""))' \
      /opt/klipper-image-backup-manager/build-info.json 2>/dev/null || true)
    dirty=$(/usr/bin/python3 -c 'import json,sys; print(str(bool(json.load(open(sys.argv[1])).get("dirty", False))).lower())' \
      /opt/klipper-image-backup-manager/build-info.json 2>/dev/null || true)
    if [[ $current == "$latest" && $dirty != true ]]; then
      echo "KIBM ist bereits auf dem neuesten signierten Release ($tag)."
      exit 0
    fi
    /usr/bin/printf '%s\n' "$latest" > "$workdir/source/BUILD_COMMIT"
    cd "$workdir/source"
    SUDO_USER="$operator" KIBM_SOURCE_COMMIT="$latest" KIBM_INSTALL_CONFIRM=1 /usr/bin/bash ./install.sh
    ;;
  *) usage ;;
esac
